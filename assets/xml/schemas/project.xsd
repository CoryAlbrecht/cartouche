<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="http://cartouche.maps.hanfastolfe.com/schemas/project/1.0"
  xmlns:mgp="http://cartouche.maps.hanfastolfe.com/schemas/project/1.0"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified"
  version="1.0">

  <xs:annotation>
    <xs:documentation> Cartouche Project File XML Schema (version 1.0). Defines the persistence
      structure for Cartouche map workspaces, layer hierarchies, coordinate reference systems, map
      viewport states, and project metadata. </xs:documentation>
  </xs:annotation>

  <!-- Root Element -->
  <xs:element name="CartoucheProject" type="mgp:ProjectType" />

  <!-- Complex Type: Project Definition -->
  <xs:complexType name="ProjectType">
    <xs:sequence>
      <!-- Project Metadata -->
      <xs:element name="metadata" type="mgp:ProjectMetadataType" />

      <!-- Coordinate Reference System (CRS) -->
      <xs:element name="crs" type="mgp:CrsType" />

      <!-- Map Viewport Extent and Camera State -->
      <xs:element name="viewport" type="mgp:ViewportType" />

      <!-- Data Layers Collection -->
      <xs:element name="layers" type="mgp:LayersCollectionType" />

      <!-- Layer Tree Hierarchy (Table of Contents Groups & Ordering) -->
      <xs:element name="layerTree" type="mgp:LayerTreeType" />

      <!-- Optional Bookmarks -->
      <xs:element name="bookmarks" type="mgp:BookmarksCollectionType" minOccurs="0" />

      <!-- Extensible Project Properties / Key-Value Settings -->
      <xs:element name="customProperties" type="mgp:CustomPropertiesType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" use="required" fixed="1.0" />
    <xs:attribute name="encoding" type="xs:string" default="UTF-8" />
  </xs:complexType>

  <!-- Metadata Type -->
  <xs:complexType name="ProjectMetadataType">
    <xs:sequence>
      <xs:element name="title" type="xs:string" />
      <xs:element name="description" type="xs:string" minOccurs="0" />
      <xs:element name="author" type="xs:string" minOccurs="0" />
      <xs:element name="createdAt" type="xs:dateTime" />
      <xs:element name="updatedAt" type="xs:dateTime" />
      <xs:element name="appVersion" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!-- CRS Type -->
  <xs:complexType name="CrsType">
    <xs:sequence>
      <xs:element name="authId" type="xs:string">
        <xs:annotation>
          <xs:documentation>e.g., EPSG:4326, EPSG:3857</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="srid" type="xs:integer" minOccurs="0" />
      <xs:element name="description" type="xs:string" minOccurs="0" />
      <xs:element name="proj4" type="xs:string" minOccurs="0" />
      <xs:element name="wkt" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!-- Viewport Type -->
  <xs:complexType name="ViewportType">
    <xs:sequence>
      <xs:element name="extent" type="mgp:EnvelopeType" />
      <xs:element name="center" type="mgp:Point2DType" minOccurs="0" />
      <xs:element name="zoom" type="xs:double" minOccurs="0" />
      <xs:element name="scale" type="xs:double" minOccurs="0" />
      <xs:element name="rotation" type="xs:double" default="0.0" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EnvelopeType">
    <xs:attribute name="xmin" type="xs:double" use="required" />
    <xs:attribute name="ymin" type="xs:double" use="required" />
    <xs:attribute name="xmax" type="xs:double" use="required" />
    <xs:attribute name="ymax" type="xs:double" use="required" />
  </xs:complexType>

  <xs:complexType name="Point2DType">
    <xs:attribute name="x" type="xs:double" use="required" />
    <xs:attribute name="y" type="xs:double" use="required" />
  </xs:complexType>

  <!-- Layers Collection -->
  <xs:complexType name="LayersCollectionType">
    <xs:sequence>
      <xs:element name="layer" type="mgp:LayerType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!-- Individual Layer Type -->
  <xs:complexType name="LayerType">
    <xs:sequence>
      <xs:element name="name" type="xs:string" />
      <xs:element name="source" type="mgp:LayerSourceType" />
      <xs:element name="crs" type="mgp:CrsType" minOccurs="0" />
      <xs:element name="styleReference" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Relative or absolute URI to an external Cartouche style file (.xml/.mgs)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="customProperties" type="mgp:CustomPropertiesType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required" />
    <xs:attribute name="type" type="mgp:LayerKindType" use="required" />
    <xs:attribute name="visible" type="xs:boolean" default="true" />
    <xs:attribute name="opacity" type="mgp:OpacityType" default="1.0" />
    <xs:attribute name="selectable" type="xs:boolean" default="true" />
    <xs:attribute name="minScale" type="xs:double" minOccurs="0" />
    <xs:attribute name="maxScale" type="xs:double" minOccurs="0" />
  </xs:complexType>

  <xs:simpleType name="LayerKindType">
    <xs:restriction釘base="xs:string">
    <xs:enumeration value="vector" />
    <xs:enumeration value="raster" />
    <xs:enumeration value="tile" />
    <xs:enumeration value="wms" />
    <xs:enumeration value="wmts" />
    <xs:enumeration value="wfs" />
    <xs:enumeration value="pointcloud" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OpacityType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0" />
      <xs:maxInclusive value="1.0" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Layer Source Specification -->
  <xs:complexType name="LayerSourceType">
    <xs:sequence>
      <xs:element name="path" type="xs:string">
        <xs:annotation>
          <xs:documentation>Local file path, database connection string, or service endpoint URI</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="format" type="xs:string">
        <xs:annotation>
          <xs:documentation>e.g., GeoJSON, Shapefile, FlatGeobuf, GeoTIFF, GeoPackage, PostGIS, OSM</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="encoding" type="xs:string" default="UTF-8" minOccurs="0" />
      <xs:element name="subsetFilter" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>SQL or spatial expression filter for vector features</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Layer Tree / Hierarchy -->
  <xs:complexType name="LayerTreeType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="group" type="mgp:LayerTreeGroupType" />
      <xs:element name="layerRef" type="mgp:LayerTreeRefType" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="LayerTreeGroupType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="group" type="mgp:LayerTreeGroupType" />
      <xs:element name="layerRef" type="mgp:LayerTreeRefType" />
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="expanded" type="xs:boolean" default="true" />
    <xs:attribute name="checked" type="xs:boolean" default="true" />
  </xs:complexType>

  <xs:complexType name="LayerTreeRefType">
    <xs:attribute name="id" type="xs:string" use="required" />
    <xs:attribute name="visible" type="xs:boolean" default="true" />
  </xs:complexType>

  <!-- Bookmarks Collection -->
  <xs:complexType name="BookmarksCollectionType">
    <xs:sequence>
      <xs:element name="bookmark" type="mgp:BookmarkType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BookmarkType">
    <xs:sequence>
      <xs:element name="name" type="xs:string" />
      <xs:element name="extent" type="mgp:EnvelopeType" />
      <xs:element name="crs" type="mgp:CrsType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required" />
  </xs:complexType>

  <!-- Custom Key-Value Properties -->
  <xs:complexType name="CustomPropertiesType">
    <xs:sequence>
      <xs:element name="property" type="mgp:PropertyItemType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PropertyItemType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="key" type="xs:string" use="required" />
        <xs:attribute name="type" type="xs:string" default="string" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

</xs:schema>
