<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="http://maps.hanfastolfe.com/cartouche/schemas/project/1.0"
  xmlns="http://maps.hanfastolfe.com/cartouche/schemas/project/1.0"
  xmlns:cartouche="http://maps.hanfastolfe.com/cartouche/schemas/project/1.0"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified"
  version="1.0">

  <xs:annotation>
    <xs:documentation>
      Cartouche Project File XML Schema (version 1.0). Defines the persistence
      structure for Cartouche map workspaces, project metadata, coordinate reference systems,
      map viewport camera states, layer/group hierarchies, and shared styles.
    </xs:documentation>
  </xs:annotation>

  <xs:import namespace="http://purl.org/dc/elements/1.1/" schemaLocation="dc.xsd" />

  <!-- Root Element -->
  <xs:element name="project" type="ProjectType" />

  <!-- Complex Type: Project Definition -->
  <xs:complexType name="ProjectType">
    <xs:sequence>
      <!-- Project Metadata (Dublin Core + application properties) -->
      <xs:element name="metadata" type="MetadataType" />

      <!-- Project Home: directory relative paths are resolved from; relative to the project file where possible - Optional -->
      <xs:element name="home" type="xs:string" minOccurs="0" />

      <!-- Coordinate Reference System (CRS) - Optional -->
      <xs:element name="crs" type="CrsType" minOccurs="0" />

      <!-- Project-wide Map Display Settings (background colour) - Optional -->
      <xs:element name="display" type="DisplayType" minOccurs="0" />

      <!-- Map Viewport Extent and Camera State - Optional -->
      <xs:element name="viewport" type="ViewportType" minOccurs="0" />

      <!-- Data Layers and Groups Collection - Optional -->
      <xs:element name="layers" type="LayersType" minOccurs="0" />

      <!-- Shared Styles Collection - Optional -->
      <xs:element name="styles" type="StylesType" minOccurs="0" />

      <!-- Optional Bookmarks Collection -->
      <xs:element name="bookmarks" type="BookmarksCollectionType" minOccurs="0" />

      <!-- Optional Workbench Time Filter State -->
      <xs:element name="timeFilter" type="TimeFilterType" minOccurs="0" />

      <!-- Extensible Project Properties / Key-Value Settings -->
      <xs:element name="customProperties" type="CustomPropertiesType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" default="1.0" />
    <xs:attribute name="encoding" type="xs:string" default="UTF-8" />
    <!-- Save Path Mode: how project-referenced file paths are written. Missing means absolute. -->
    <xs:attribute name="pathMode" type="PathModeType" />
  </xs:complexType>

  <!-- Save Path Mode enumeration -->
  <xs:simpleType name="PathModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="absolute" />
      <xs:enumeration value="relative" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Metadata Type (supports standard Dublin Core elements and Cartouche metadata) -->
  <xs:complexType name="MetadataType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="dc:title" />
      <xs:element ref="dc:creator" />
      <xs:element ref="dc:subject" />
      <xs:element ref="dc:description" />
      <xs:element ref="dc:publisher" />
      <xs:element ref="dc:contributor" />
      <xs:element ref="dc:date" />
      <xs:element ref="dc:type" />
      <xs:element ref="dc:format" />
      <xs:element ref="dc:identifier" />
      <xs:element ref="dc:source" />
      <xs:element ref="dc:language" />
      <xs:element ref="dc:relation" />
      <xs:element ref="dc:coverage" />
      <xs:element ref="dc:rights" />
      <xs:element name="createdAt" type="xs:dateTime" />
      <xs:element name="updatedAt" type="xs:dateTime" />
      <xs:element name="appVersion" type="xs:string" />
      <xs:any namespace="http://purl.org/dc/elements/1.1/" processContents="lax" />
    </xs:choice>
  </xs:complexType>

  <!-- CRS Type -->
  <xs:complexType name="CrsType">
    <xs:sequence>
      <xs:element name="authId" type="xs:string">
        <xs:annotation>
          <xs:documentation>e.g., EPSG:4326, EPSG:3857</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="srid" type="xs:integer" minOccurs="0" />
      <xs:element name="description" type="xs:string" minOccurs="0" />
      <xs:element name="proj4" type="xs:string" minOccurs="0" />
      <xs:element name="wkt" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!-- Display Type: project-wide map display settings -->
  <xs:complexType name="DisplayType">
    <xs:attribute name="backgroundColour" type="xs:string">
      <xs:annotation>
        <xs:documentation>Opaque CSS colour painted behind all layers in the map viewport. Missing means #ffffff.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selectionColour" type="xs:string">
      <xs:annotation>
        <xs:documentation>CSS colour (alpha allowed) used to highlight selected features. Missing means rgba(255,255,0,0.6).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Viewport Type -->
  <xs:complexType name="ViewportType">
    <xs:sequence>
      <xs:element name="extent" type="EnvelopeType" minOccurs="0" />
      <xs:element name="center" type="Point2DType" minOccurs="0" />
      <xs:element name="scale" type="xs:double" minOccurs="0" />
      <xs:element name="rotation" type="xs:double" default="0.0" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EnvelopeType">
    <xs:attribute name="xmin" type="xs:double" use="required" />
    <xs:attribute name="ymin" type="xs:double" use="required" />
    <xs:attribute name="xmax" type="xs:double" use="required" />
    <xs:attribute name="ymax" type="xs:double" use="required" />
  </xs:complexType>

  <xs:complexType name="Point2DType">
    <xs:attribute name="x" type="xs:double" use="required" />
    <xs:attribute name="y" type="xs:double" use="required" />
  </xs:complexType>

  <!-- Layers & Groups Collection -->
  <xs:complexType name="LayersType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="layer" type="LayerType" />
      <xs:element name="group" type="GroupType" />
    </xs:choice>
  </xs:complexType>

  <!-- Group Type (supports nested groups and layers) -->
  <xs:complexType name="GroupType">
    <xs:sequence>
      <xs:element name="name" type="xs:string" minOccurs="0" />
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="layer" type="LayerType" />
        <xs:element name="group" type="GroupType" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" />
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="visible" type="xs:boolean" default="true" />
    <xs:attribute name="expanded" type="xs:boolean" default="true" />
  </xs:complexType>

  <!-- Individual Layer Type -->
  <xs:complexType name="LayerType">
    <xs:all>
      <xs:element name="name" type="xs:string" />
      <xs:element name="type" type="xs:string">
        <xs:annotation>
          <xs:documentation>Layer format identifier, e.g. esri-shapefile, geojson, geotiff, gpkg</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="source" type="xs:string">
        <xs:annotation>
          <xs:documentation>Relative or absolute file path, URI, or connection string</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="style" type="StyleType" minOccurs="0" />
      <xs:element name="crs" type="CrsType" minOccurs="0" />
      <xs:element name="fields" type="FieldsType" minOccurs="0" />
      <xs:element name="customProperties" type="CustomPropertiesType" minOccurs="0" />
      <xs:element name="temporal" type="LayerTemporalType" minOccurs="0" />
    </xs:all>
    <xs:attribute name="id" type="xs:string" use="required" />
    <xs:attribute name="visible" type="xs:boolean" default="true" />
    <xs:attribute name="readOnly" type="xs:boolean" default="false" />
    <xs:attribute name="layerKind" type="xs:string" />
    <xs:attribute name="geometryKind" type="xs:string" />
    <xs:attribute name="opacity" type="OpacityType" default="1.0" />
    <xs:attribute name="selectable" type="xs:boolean" default="true" />
    <xs:attribute name="minScale" type="xs:double" />
    <xs:attribute name="maxScale" type="xs:double" />
    <xs:attribute name="temporalEnabled" type="xs:boolean" default="false" />
  </xs:complexType>

  <!-- Layer Temporal Configuration Type -->
  <xs:complexType name="LayerTemporalType">
    <xs:attribute name="enabled" type="xs:boolean" default="true" />
    <xs:attribute name="mode" type="xs:string" default="start_end" />
    <xs:attribute name="startField" type="xs:string" />
    <xs:attribute name="startOp" type="xs:string" />
    <xs:attribute name="endField" type="xs:string" />
    <xs:attribute name="endOp" type="xs:string" />
  </xs:complexType>

  <!-- Time Filter Type: Project-level temporal transport configuration -->
  <xs:complexType name="TimeFilterType">
    <xs:attribute name="enabled" type="xs:boolean" default="false" />
    <xs:attribute name="from" type="xs:string" />
    <xs:attribute name="to" type="xs:string" />
    <xs:attribute name="current" type="xs:string" />
    <xs:attribute name="step" type="xs:double" default="1.0" />
    <xs:attribute name="unit" type="xs:string" default="Days" />
  </xs:complexType>

  <!-- Layer Attribute Fields Collection Type -->
  <xs:complexType name="FieldsType">
    <xs:sequence>
      <xs:element name="field" type="FieldDefinitionType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!-- Layer Attribute Field Definition -->
  <xs:complexType name="FieldDefinitionType">
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="nativeType" type="xs:string" use="required" />
    <xs:attribute name="inferredType" type="InferredFieldType" use="required" />
    <xs:attribute name="nativeSubType" type="xs:string" />
    <xs:attribute name="alternativeName" type="xs:string" />
    <xs:attribute name="domainName" type="xs:string" />
    <xs:attribute name="defaultValue" type="xs:string" />
    <xs:attribute name="width" type="xs:integer" />
    <xs:attribute name="precision" type="xs:integer" />
    <xs:attribute name="nullable" type="xs:boolean" />
    <xs:attribute name="userOverridden" type="xs:boolean" />
  </xs:complexType>

  <!-- Inferred Attribute Field Data Type Taxonomy -->
  <xs:simpleType name="InferredFieldType">
    <xs:restriction base="xs:string">
      <!-- Scalar Types -->
      <xs:enumeration value="string" />
      <xs:enumeration value="integer" />
      <xs:enumeration value="real" />
      <xs:enumeration value="boolean" />
      <xs:enumeration value="date" />
      <xs:enumeration value="time" />
      <xs:enumeration value="datetime" />
      <xs:enumeration value="uuid" />
      <xs:enumeration value="json" />
      <xs:enumeration value="binary" />
      <!-- Array / List Types -->
      <xs:enumeration value="string[]" />
      <xs:enumeration value="integer[]" />
      <xs:enumeration value="real[]" />
      <xs:enumeration value="boolean[]" />
      <xs:enumeration value="date[]" />
      <xs:enumeration value="time[]" />
      <xs:enumeration value="datetime[]" />
      <xs:enumeration value="uuid[]" />
      <xs:enumeration value="json[]" />
      <xs:enumeration value="binary[]" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OpacityType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0" />
      <xs:maxInclusive value="1.0" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Style Type (supports inline OpenLayers flat styles or SLD CDATA, or href reference) -->
  <xs:complexType name="StyleType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="xs:string" />
        <xs:attribute name="href" type="xs:anyURI" />
        <xs:attribute name="format" type="StyleFormatType" default="openlayers" />
        <xs:attribute name="version" type="xs:string" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Shared Style Type (requires an id attribute and contains CDATA styling rules) -->
  <xs:complexType name="SharedStyleType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="xs:string" use="required" />
        <xs:attribute name="format" type="StyleFormatType" default="openlayers" />
        <xs:attribute name="version" type="xs:string" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Style Format Enumeration: Cartouche Symbology, OpenLayers Flat Style JSON, or OGC SLD XML -->
  <xs:simpleType name="StyleFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="cartouche" />
      <xs:enumeration value="openlayers" />
      <xs:enumeration value="sld" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Shared Styles Collection -->
  <xs:complexType name="StylesType">
    <xs:sequence>
      <xs:element name="style" type="SharedStyleType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!-- Bookmarks Collection -->
  <xs:complexType name="BookmarksCollectionType">
    <xs:sequence>
      <xs:element name="bookmark" type="BookmarkType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BookmarkType">
    <xs:sequence>
      <xs:element name="name" type="xs:string" />
      <xs:element name="extent" type="EnvelopeType" />
      <xs:element name="crs" type="CrsType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required" />
  </xs:complexType>

  <!-- Custom Key-Value Properties -->
  <xs:complexType name="CustomPropertiesType">
    <xs:sequence>
      <xs:element name="property" type="PropertyItemType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PropertyItemType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="key" type="xs:string" use="required" />
        <xs:attribute name="type" type="xs:string" default="string" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

</xs:schema>
