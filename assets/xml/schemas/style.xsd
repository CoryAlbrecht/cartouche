<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://cartouche.map/schemas/style/1.0"
           xmlns:mgs="http://cartouche.map/schemas/style/1.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <xs:annotation>
    <xs:documentation>
      Cartouche Layer Styling XML Schema (version 1.0).
      Defines symbology, visual rendering rules, color ramps, markers, strokes,
      fills, and cartographic labeling for vector and raster geospatial layers.
    </xs:documentation>
  </xs:annotation>

  <!-- Root Element -->
  <xs:element name="CartoucheStyle" type="mgs:StyleType"/>

  <!-- Complex Type: Style Definition -->
  <xs:complexType name="StyleType">
    <xs:sequence>
      <!-- Style Metadata -->
      <xs:element name="metadata" type="mgs:StyleMetadataType"/>

      <!-- Symbology Renderer Definition -->
      <xs:element name="renderer" type="mgs:RendererType"/>

      <!-- Optional Cartographic Labeling -->
      <xs:element name="labeling" type="mgs:LabelingType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" use="required" fixed="1.0"/>
    <xs:attribute name="targetGeometry" type="mgs:GeometryType" default="Any"/>
  </xs:complexType>

  <xs:simpleType name="GeometryType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Point"/>
      <xs:enumeration value="LineString"/>
      <xs:enumeration value="Polygon"/>
      <xs:enumeration value="MultiPoint"/>
      <xs:enumeration value="MultiLineString"/>
      <xs:enumeration value="MultiPolygon"/>
      <xs:enumeration value="Raster"/>
      <xs:enumeration value="Any"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Style Metadata -->
  <xs:complexType name="StyleMetadataType">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
      <xs:element name="author" type="xs:string" minOccurs="0"/>
      <xs:element name="createdAt" type="xs:dateTime" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Renderer Type: Choice of Vector or Raster Renderers -->
  <xs:complexType name="RendererType">
    <xs:choice>
      <xs:element name="singleSymbol" type="mgs:SingleSymbolRendererType"/>
      <xs:element name="categorized" type="mgs:CategorizedRendererType"/>
      <xs:element name="graduated" type="mgs:GraduatedRendererType"/>
      <xs:element name="ruleBased" type="mgs:RuleBasedRendererType"/>
      <xs:element name="rasterRenderer" type="mgs:RasterRendererType"/>
    </xs:choice>
    <xs:attribute name="opacity" type="mgs:OpacityType" default="1.0"/>
    <xs:attribute name="blendMode" type="mgs:BlendModeType" default="normal"/>
  </xs:complexType>

  <!-- 1. Single Symbol Renderer -->
  <xs:complexType name="SingleSymbolRendererType">
    <xs:sequence>
      <xs:element name="symbol" type="mgs:SymbolType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- 2. Categorized Renderer (Unique Values) -->
  <xs:complexType name="CategorizedRendererType">
    <xs:sequence>
      <xs:element name="category" type="mgs:CategoryItemType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="attribute" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="CategoryItemType">
    <xs:sequence>
      <xs:element name="symbol" type="mgs:SymbolType"/>
    </xs:sequence>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:attribute name="label" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- 3. Graduated Renderer (Classification Ranges) -->
  <xs:complexType name="GraduatedRendererType">
    <xs:sequence>
      <xs:element name="range" type="mgs:RangeItemType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="attribute" type="xs:string" use="required"/>
    <xs:attribute name="method" type="mgs:GraduatedMethodType" default="quantile"/>
  </xs:complexType>

  <xs:simpleType name="GraduatedMethodType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="equalInterval"/>
      <xs:enumeration value="quantile"/>
      <xs:enumeration value="naturalBreaks"/>
      <xs:enumeration value="standardDeviation"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="RangeItemType">
    <xs:sequence>
      <xs:element name="symbol" type="mgs:SymbolType"/>
    </xs:sequence>
    <xs:attribute name="lowerBound" type="xs:double" use="required"/>
    <xs:attribute name="upperBound" type="xs:double" use="required"/>
    <xs:attribute name="label" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- 4. Rule-Based Renderer -->
  <xs:complexType name="RuleBasedRendererType">
    <xs:sequence>
      <xs:element name="rule" type="mgs:RuleItemType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RuleItemType">
    <xs:sequence>
      <xs:element name="filter" type="xs:string">
        <xs:annotation>
          <xs:documentation>Expression filter (e.g. population &gt; 50000)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="symbol" type="mgs:SymbolType"/>
    </xs:sequence>
    <xs:attribute name="label" type="xs:string" use="required"/>
    <xs:attribute name="minScale" type="xs:double" minOccurs="0"/>
    <xs:attribute name="maxScale" type="xs:double" minOccurs="0"/>
  </xs:complexType>

  <!-- 5. Raster Renderer -->
  <xs:complexType name="RasterRendererType">
    <xs:choice>
      <xs:element name="singlebandPseudocolor" type="mgs:PseudocolorRasterType"/>
      <xs:element name="singlebandGray" type="mgs:SinglebandGrayRasterType"/>
      <xs:element name="multibandColor" type="mgs:MultibandColorRasterType"/>
      <xs:element name="hillshade" type="mgs:HillshadeRasterType"/>
    </xs:choice>
    <xs:attribute name="nodataColor" type="mgs:ColorHexType" default="#00000000"/>
  </xs:complexType>

  <xs:complexType name="PseudocolorRasterType">
    <xs:sequence>
      <xs:element name="colorRamp" type="mgs:ColorRampType"/>
    </xs:sequence>
    <xs:attribute name="band" type="xs:positiveInteger" default="1"/>
    <xs:attribute name="min" type="xs:double" use="required"/>
    <xs:attribute name="max" type="xs:double" use="required"/>
  </xs:complexType>

  <xs:complexType name="SinglebandGrayRasterType">
    <xs:attribute name="band" type="xs:positiveInteger" default="1"/>
    <xs:attribute name="contrastEnhancement" type="xs:string" default="stretchToMinMax"/>
  </xs:complexType>

  <xs:complexType name="MultibandColorRasterType">
    <xs:attribute name="redBand" type="xs:positiveInteger" default="1"/>
    <xs:attribute name="greenBand" type="xs:positiveInteger" default="2"/>
    <xs:attribute name="blueBand" type="xs:positiveInteger" default="3"/>
  </xs:complexType>

  <xs:complexType name="HillshadeRasterType">
    <xs:attribute name="band" type="xs:positiveInteger" default="1"/>
    <xs:attribute name="azimuth" type="xs:double" default="315.0"/>
    <xs:attribute name="altitude" type="xs:double" default="45.0"/>
    <xs:attribute name="zFactor" type="xs:double" default="1.0"/>
  </xs:complexType>

  <!-- Color Ramp Definition -->
  <xs:complexType name="ColorRampType">
    <xs:sequence>
      <xs:element name="stop" type="mgs:ColorStopType" minOccurs="2" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" minOccurs="0"/>
  </xs:complexType>

  <xs:complexType name="ColorStopType">
    <xs:attribute name="value" type="xs:double" use="required"/>
    <xs:attribute name="color" type="mgs:ColorHexType" use="required"/>
    <xs:attribute name="label" type="xs:string" minOccurs="0"/>
  </xs:complexType>

  <!-- Symbol Definition (Marker, Line, Fill) -->
  <xs:complexType name="SymbolType">
    <xs:choice>
      <xs:element name="marker" type="mgs:MarkerSymbolType"/>
      <xs:element name="line" type="mgs:LineSymbolType"/>
      <xs:element name="fill" type="mgs:FillSymbolType"/>
    </xs:choice>
  </xs:complexType>

  <!-- Marker Symbol (Points) -->
  <xs:complexType name="MarkerSymbolType">
    <xs:sequence>
      <xs:element name="stroke" type="mgs:StrokeType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="shape" type="mgs:MarkerShapeType" default="circle"/>
    <xs:attribute name="size" type="xs:double" default="6.0"/>
    <xs:attribute name="fillColor" type="mgs:ColorHexType" default="#3b82f6"/>
    <xs:attribute name="fillOpacity" type="mgs:OpacityType" default="1.0"/>
    <xs:attribute name="rotation" type="xs:double" default="0.0"/>
  </xs:complexType>

  <xs:simpleType name="MarkerShapeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="circle"/>
      <xs:enumeration value="square"/>
      <xs:enumeration value="triangle"/>
      <xs:enumeration value="diamond"/>
      <xs:enumeration value="cross"/>
      <xs:enumeration value="star"/>
      <xs:enumeration value="svg"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Line Symbol (Lines & Outlines) -->
  <xs:complexType name="LineSymbolType">
    <xs:sequence>
      <xs:element name="stroke" type="mgs:StrokeType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="StrokeType">
    <xs:attribute name="color" type="mgs:ColorHexType" default="#000000"/>
    <xs:attribute name="width" type="xs:double" default="1.0"/>
    <xs:attribute name="opacity" type="mgs:OpacityType" default="1.0"/>
    <xs:attribute name="dashArray" type="xs:string" default="solid"/>
    <xs:attribute name="lineCap" type="mgs:LineCapType" default="round"/>
    <xs:attribute name="lineJoin" type="mgs:LineJoinType" default="round"/>
  </xs:complexType>

  <xs:simpleType name="LineCapType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="butt"/>
      <xs:enumeration value="round"/>
      <xs:enumeration value="square"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LineJoinType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="miter"/>
      <xs:enumeration value="round"/>
      <xs:enumeration value="bevel"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Fill Symbol (Polygons) -->
  <xs:complexType name="FillSymbolType">
    <xs:sequence>
      <xs:element name="stroke" type="mgs:StrokeType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="fillColor" type="mgs:ColorHexType" default="#93c5fd"/>
    <xs:attribute name="fillOpacity" type="mgs:OpacityType" default="0.75"/>
    <xs:attribute name="pattern" type="xs:string" default="solid"/>
  </xs:complexType>

  <!-- Cartographic Labeling Definition -->
  <xs:complexType name="LabelingType">
    <xs:sequence>
      <xs:element name="font" type="mgs:LabelFontType"/>
      <xs:element name="halo" type="mgs:LabelHaloType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    <xs:attribute name="field" type="xs:string" use="required"/>
    <xs:attribute name="placement" type="mgs:LabelPlacementType" default="center"/>
    <xs:attribute name="minScale" type="xs:double" minOccurs="0"/>
    <xs:attribute name="maxScale" type="xs:double" minOccurs="0"/>
  </xs:complexType>

  <xs:complexType name="LabelFontType">
    <xs:attribute name="family" type="xs:string" default="sans-serif"/>
    <xs:attribute name="size" type="xs:double" default="11.0"/>
    <xs:attribute name="color" type="mgs:ColorHexType" default="#000000"/>
    <xs:attribute name="bold" type="xs:boolean" default="false"/>
    <xs:attribute name="italic" type="xs:boolean" default="false"/>
  </xs:complexType>

  <xs:complexType name="LabelHaloType">
    <xs:attribute name="color" type="mgs:ColorHexType" default="#ffffff"/>
    <xs:attribute name="size" type="xs:double" default="1.5"/>
  </xs:complexType>

  <xs:simpleType name="LabelPlacementType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="center"/>
      <xs:enumeration value="above"/>
      <xs:enumeration value="below"/>
      <xs:enumeration value="alongLine"/>
      <xs:enumeration value="perimeter"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Common Utility Types -->
  <xs:simpleType name="ColorHexType">
    <xs:restriction base="xs:string">
      <xs:pattern value="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OpacityType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0"/>
      <xs:maxInclusive value="1.0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BlendModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="normal"/>
      <xs:enumeration value="multiply"/>
      <xs:enumeration value="screen"/>
      <xs:enumeration value="overlay"/>
      <xs:enumeration value="darken"/>
      <xs:enumeration value="lighten"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
