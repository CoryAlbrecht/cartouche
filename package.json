{
  "name": "cartouche",
  "version": "0.1.0",
  "type": "module",
  "description": "Cartouche - Modern Desktop GIS Application",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "rebuild:gdal-async": "electron-rebuild -j 12 -f -w gdal-async",
    "rebuild:better-sqlite3": "electron-rebuild -j 12 -f -w better-sqlite3",
    "rebuild": "rebuild:gdal-async && rebuild:better-sqlite3",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "stylelint \"src/**/*.css\"",
    "start": "vite",
    "preview": "vite build && electron dist-electron/main/main.js --no-sandbox",
    "package": "electron-builder build",
    "package:linux": "electron-builder build --linux deb rpm",
    "package:win": "electron-builder build --win msi nsis",
    "test": "echo \"No test specified\" && exit 0"
  },
  "keywords": [
    "gis",
    "mapping",
    "geospatial",
    "electron",
    "desktop-gis"
  ],
  "author": "Cory Albrecht",
  "license": "MIT",
  "build": {
    "appId": "com.hanfastolfe.maps.cartouche",
    "productName": "Cartouche",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/gdal-async/**/*"
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Graphics;Science;Geoscience"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libasound2",
        "libc6"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "alsa-lib",
        "glibc"
      ]
    },
    "win": {
      "target": [
        "msi",
        "nsis"
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": false
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/ol-ext": "npm:@siedlerchr/types-ol-ext@^3.6.8",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@preact/signals-react": "^3.12.0",
    "@turf/turf": "^7.4.0",
    "better-sqlite3": "^13.0.3",
    "dockview-react": "^8.3.1",
    "flatgeobuf": "^4.4.0",
    "gdal-async": "^3.12.3",
    "geostyler": "^18.6.0",
    "geotiff": "^3.1.0-beta.0",
    "ol": "^10.10.0",
    "ol-ext": "^4.0.38",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
