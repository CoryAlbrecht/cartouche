{
  "name": "cartouche",
  "desktopName": "cartouche.desktop",
  "version": "0.1.0-dev",
  "type": "module",
  "description": "Cartouche - Modern Desktop GIS Application",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "rebuild:sqlite": "node-gyp rebuild --directory=node_modules/better-sqlite3 --target=44.7.0 --arch=x64 --dist-url=https://electronjs.org/headers --force_build=1",
    "rebuild:gdal": "node node_modules/gdal-async/node_modules/@mapbox/node-pre-gyp/bin/node-pre-gyp rebuild -j 12 --directory=node_modules/gdal-async --target=44.7.0 --runtime=electron --dist-url=https://electronjs.org/headers",
    "rebuild": "npm run rebuild:sqlite && npm run rebuild:gdal",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "stylelint \"src/**/*.css\"",
    "start": "vite",
    "preview": "vite build && electron dist-electron/main/main.js --no-sandbox",
    "package:linux": "node scripts/package-linux.js",
    "package:win": "electron-builder build --win msi nsis",
    "postinstall": "electron-builder install-app-deps",
    "clean:rebuild": "rimraf node_modules/gdal-async/build node_modules/better-sqlite3/build",
    "clean:build": "rimraf dist dist-electron",
    "clean:package": "rimraf release",
    "clean": "npm run clean:build && npm run clean:rebuild && npm run clean:package",
    "validate:tree": "node scripts/validate-directory-tree.js",
    "test": "node --import jiti/register --test \"tests/**/*.test.ts\""
  },
  "keywords": [
    "gis",
    "mapping",
    "geospatial",
    "electron",
    "desktop-gis"
  ],
  "author": "Cory Albrecht <cory@hanfastolfe.com>",
  "license": "MIT",
  "build": {
    "appId": "com.hanfastolfe.maps.cartouche",
    "productName": "Cartouche",
    "electronVersion": "44.7.0",
    "npmRebuild": false,
    "icon": "assets/icon.png",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      "assets/icon.png",
      "assets/logo.png",
      "assets/svg/logo.svg"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "assets/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/gdal-async/**/*"
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Graphics",
      "executableName": "cartouche",
      "icon": "assets/icon.png"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libasound2",
        "libc6"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "alsa-lib",
        "glibc"
      ]
    },
    "win": {
      "target": [
        "msi",
        "nsis"
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": false
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/ol-ext": "npm:@siedlerchr/types-ol-ext@^3.6.8",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/winston": "^2.4.4",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.3",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@preact/signals-react": "^3.12.0",
    "@turf/turf": "^7.4.0",
    "better-sqlite3": "^13.0.3",
    "colorette": "^2.0.20",
    "dockview-react": "^8.3.1",
    "fast-xml-parser": "^5.11.1",
    "flatgeobuf": "^4.4.0",
    "gdal-async": "github:CoryAlbrecht/node-gdal-async#fix/v8-sandbox-wkb",
    "geostyler": "^18.6.0",
    "geotiff": "^3.1.0-beta.0",
    "ol": "^10.10.0",
    "ol-ext": "^4.0.38",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "winston": "^3.19.0"
  }
}
